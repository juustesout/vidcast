# Copy this file to `.env` in the repo root and fill in a real, short-lived key.
# `.env` and `.env.*` are gitignored; never commit real keys. Give the key a
# small spend cap / short expiry and revoke it when the pilot is done.

# --- Real OpenAI image pilot (opt-in, fail-closed) ---
# CONFIRM_REAL_IMAGE_PILOT must equal exactly YES, otherwise nothing runs.
RUN_REAL_IMAGE_PILOT=true
CONFIRM_REAL_IMAGE_PILOT=YES
OPENAI_API_KEY=sk-replace-me

# Optional overrides
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_TIMEOUT_MS=90000

# --- Real ElevenLabs narration pilot (opt-in, fail-closed) ---
# CONFIRM_REAL_NARRATION_PILOT must equal exactly YES, otherwise nothing runs.
RUN_REAL_NARRATION_PILOT=true
CONFIRM_REAL_NARRATION_PILOT=YES
ELEVENLABS_API_KEY=replace-me

# Optional overrides
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_TTS_TIMEOUT_MS=60000
# TTS_DEFAULT_VOICE_ID=replace-me
# TTS_DEFAULT_FORMAT=mp3

# --- FAL.ai video generation (real provider) ---
# Only used when a run/manual call selects the `fal` provider in real mode with
# PRODUCTION_RUN_ALLOW_REAL_PROVIDERS=true. Values below are placeholders; set a
# real key with a small spend cap and revoke it when done. FAL_KEY is never
# logged and is only sent to queue.fal.run.
FAL_KEY=replace-me

# Optional overrides
# FAL_VIDEO_ENDPOINT=minimax/h3-max-turbo/text-to-video
# FAL_VIDEO_BASE_URL=https://queue.fal.run
# FAL_VIDEO_TIMEOUT_MS=120000
# FAL_VIDEO_PROMPT_EXPANSION_MODE=disabled
# FAL_VIDEO_RESOLUTION=768P

# --- Local FFmpeg memory safety ---
# Maximum simultaneous local FFmpeg processes across scene renders and final
# composition in one Node.js process. Default 1 (safe for an 8-GB runtime);
# values above 4 are rejected. Requests for higher per-action concurrency are
# clamped to this server limit.
# FFMPEG_MAX_CONCURRENCY=1
